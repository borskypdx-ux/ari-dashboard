<script>
  const tabs = document.getElementsByClassName('tab_1');

  // Funkce pro přepínání tabů na základě ID
  function changeTab(tabId) {
    // Skryj všechny taby
    for (let i = 0; i < tabs.length; i++) {
      tabs[i].classList.remove('active');
    }

    // Zobraz vybraný tab
    const selectedTab = document.getElementById(`tabContent${tabId}`);
    selectedTab.classList.add('active');

    // Odeber třídu 'active' ze všech záložek
    const tabButtons = document.querySelectorAll('.tab-buttons div');
    tabButtons.forEach((tabButton) => {
      tabButton.classList.remove('active');
    });

    // Přidej třídu 'active' k příslušné záložce
    const activeTabButton = document.getElementById(`tabButton${tabId}`);
    activeTabButton.classList.add('active');
  }

  // Zobraz první tab při načtení stránky a přidej třídu active
  window.onload = function () {
    changeTab(1);
  };
</script>

